generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CvAnalysis {
  id                 String   @id @default(cuid())
  candidateName      String
  targetRole         String
  filename           String
  stage              String
  label              String
  confidence         Float
  modelName          String
  fairnessAdjusted   Boolean  @default(false)
  topDriver          String   @default("")
  reasons            String   @default("")
  probabilitiesInvite Float   @default(0)
  probabilitiesReject Float   @default(0)
  shapValues         String   @default("{}")
  features           String   @default("{}")
  hardFilterReasons  String   @default("[]")
  decisionDrivers    String   @default("")
  version            String   @default("V2")
  createdAt          DateTime @default(now())
}

model FilterConfig {
  id                  String   @id @default(cuid())
  name                String   @unique
  requiredLanguages   String   @default("[]")
  requiredSkills      String   @default("[]")
  minEducationLevel   Int?
  minYearsExperience  Float?
  minNbPositions      Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
